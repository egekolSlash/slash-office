        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gece ve gündüz"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitti"
          }
        }
      }
