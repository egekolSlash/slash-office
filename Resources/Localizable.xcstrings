{
  "sourceLanguage": "en",
  "strings": {
    "%@ · Appearance": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Görünüm"
          }
        }
      }
    },
    "%@ · Room": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Oda"
          }
        }
      }
    },
    "A 3D office you can pan and zoom, with animated villagers. Off: simple cards (less CPU and GPU).": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydırıp yakınlaştırabildiğin, köylülerin canlandığı 3B bir ofis. Kapalıyken: sade kartlar (daha az CPU ve GPU)."
          }
        }
      }
    },
    "A ✓ when the agent finished while you weren't looking.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen bakmazken ajan işini bitirdiyse ✓ görünür."
          }
        }
      }
    },
    "Actual Size": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçek boyut"
          }
        }
      }
    },
    "Add API pagination": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API sayfalamasını ekle"
          }
        }
      }
