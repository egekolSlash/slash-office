    "Claude Session": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude oturumu"
          }
        }
      }
    },
    "Claude: choose a project": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude: proje seç"
          }
        }
      }
    },
    "Click a villager to open its terminal, ⇧-click to open it beside the current pane, click an empty lot to start a new session.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalini açmak için bir köylüye tıkla, mevcut panelin yanında açmak için ⇧ ile tıkla, yeni oturum başlatmak için boş bir araziye tıkla."
          }
        }
      }
    },
    "Click an agent in the office or press ⌘T to open a new pane.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ofisten bir ajana tıkla ya da ⌘T ile yeni panel aç."
          }
        }
      }
    },
    "Close Pane": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paneli kapat"
          }
        }
      }
    },
    "Close pane (the session keeps running)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paneli kapat (oturum çalışmaya devam eder)"
          }
        }
