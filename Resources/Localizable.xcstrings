      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enerji tasarrufu"
          }
        }
      }
    },
    "Error": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hata"
          }
        }
      }
    },
    "Every project gets a room and every session a villager at a desk. Their pose tells you what the agent is doing.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her projenin bir odası, her oturumun masasında bir köylüsü var. Duruşu ajanın ne yaptığını gösterir."
          }
        }
      }
    },
    "Everything is committed.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey commit edilmiş."
          }
        }
      }
    },
    "Files the agent touches will be listed here.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanın dokunduğu dosyalar burada listelenecek."
          }
        }
      }
    },
    "Files: %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dosya"
          }
