      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son tur"
          }
        }
      }
    },
    "Lets agents in terminals take screenshots (for example to check a user interface). Restart the app after allowing.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminallerdeki ajanlar ekran görüntüsü alabilsin (ör. bir arayüzü kontrol etmek için). İzin verdikten sonra uygulamayı yeniden başlat."
          }
        }
      }
    },
    "Lets you know when an agent asks a question or waits for permission.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ajan soru sorduğunda ya da izin beklediğinde haber verir."
          }
        }
      }
    },
    "Light blue": {
      "localizations": {
