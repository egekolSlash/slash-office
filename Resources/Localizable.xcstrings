    "Agents are running": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışan ajanlar var"
          }
        }
      }
    },
    "Agents work in your folders. Grant permissions now so macOS doesn't ask one by one while they work.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanlar senin klasörlerinde çalışıyor. macOS'un çalışma sırasında tek tek sormaması için izinleri şimdi ver."
          }
        }
      }
    },
    "Allow": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin ver"
