            "value": "Gözlük"
          }
        }
      }
    },
    "Grant these now so macOS doesn't interrupt your agents later. All are optional.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunları şimdi ver; macOS ajanlarını sonradan bölmesin. Hepsi isteğe bağlı."
          }
        }
      }
    },
    "Granted": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verildi"
          }
        }
      }
    },
    "Grid bug in the level editor": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seviye editöründe ızgara hatası"
          }
        }
